---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/admin/ProductForm';
import DeleteButton from '../../../components/admin/DeleteButton';
import { getDb } from '../../../server/db';
import { listAllBrands } from '../../../server/repos/admin';
import { getAdminProduct } from '../../../server/services/products-admin';

const id = Astro.params.id;
if (!id) return Astro.redirect('/admin/products');

const product = await getAdminProduct(id);
if (!product) return Astro.redirect('/admin/products');

const brands = (await listAllBrands(getDb())).map((b) => ({ id: b.id, name: b.name }));
const toast = Astro.url.searchParams.get('toast');
---

<AdminLayout
  title={product.name}
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/products', label: 'Ürünler' },
    { label: product.name },
  ]}
>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <h1 class="font-display text-2xl font-bold">{product.name}</h1>
    <DeleteButton client:load endpoint={`/api/admin/products/${product.id}`} redirectTo="/admin/products" />
  </div>

  {
    toast === 'saved' && (
      <p class="mb-4 rounded-md border border-border bg-muted/40 px-3 py-2 text-sm">
        Ürün kaydedildi.
      </p>
    )
  }

  <ProductForm
    client:load
    mode="edit"
    productId={product.id}
    brands={brands}
    initial={{
      name: product.name,
      slug: product.slug,
      sku: product.sku ?? '',
      description: product.description ?? '',
      price: product.price,
      stock: product.stock,
      status: product.status,
      brandId: product.brandId ?? '',
      compareAtPrice: product.compareAtPrice,
      currency: product.currency,
      seo: product.seo,
    }}
    variants={product.variants.map((v) => ({
      id: v.id,
      sku: v.sku,
      name: v.name,
      price: v.price,
      stock: v.stock,
    }))}
  />
</AdminLayout>
