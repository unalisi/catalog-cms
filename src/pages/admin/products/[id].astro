---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/admin/ProductForm';
import DeleteButton from '../../../components/admin/DeleteButton';
import { getDb } from '../../../server/db';
import { listAllBrands } from '../../../server/repos/admin';
import { getAdminProduct } from '../../../server/services/products-admin';

const id = Astro.params.id;
if (!id) return Astro.redirect('/admin/products');

const product = await getAdminProduct(id);
if (!product) return Astro.redirect('/admin/products');

const brands = (await listAllBrands(getDb())).map((b) => ({ id: b.id, name: b.name }));
---

<AdminLayout
  title={product.name}
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/products', label: 'Ürünler' },
    { label: product.name },
  ]}
>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight">{product.name}</h1>
      </div>
      <DeleteButton
        client:load
        endpoint={`/api/admin/products/${product.id}`}
        redirectTo="/admin/products"
      />
    </div>

    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <ProductForm
        client:load
        mode="edit"
        productId={product.id}
        brands={brands}
        initial={{
          name: product.name,
          slug: product.slug,
          sku: product.sku ?? '',
          description: product.description ?? '',
          price: product.price,
          stock: product.stock,
          status: product.status,
          brandId: product.brandId ?? '',
          compareAtPrice: product.compareAtPrice,
          currency: product.currency,
          primaryMediaId: product.primaryMediaId,
          primaryMediaUrl: product.primaryMedia?.url ?? null,
          primaryMediaKey: product.primaryMedia?.key ?? null,
          gallery: product.gallery.map((g) => ({
            id: g.id,
            key: g.key,
            url: g.url,
            alt: g.alt,
            mime: g.mime,
          })),
          seo: product.seo,
        }}
        variants={product.variants.map((v) => ({
          id: v.id,
          sku: v.sku,
          name: v.name,
          price: v.price,
          stock: v.stock,
        }))}
      />
    </div>
  </div>
</AdminLayout>
