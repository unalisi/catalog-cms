---
import BuilderLayout from '../../../layouts/BuilderLayout.astro';
import PageBuilder from '../../../components/admin/PageBuilder';
import { getCorePage } from '../../../lib/pages/core-pages';
import {
  getAdminPage,
  listAdminPages,
  listSectionTypeOptions,
} from '../../../server/services/pages';
import { ensureCorePages } from '../../../server/services/core-pages';

const slug = Astro.params.slug;
if (!slug) return Astro.redirect('/admin/pages');

await ensureCorePages();
const page = await getAdminPage(slug);
if (!page) return Astro.redirect('/admin/pages');

const pages = await listAdminPages();
const sectionTypes = listSectionTypeOptions(page.slug);
const core = getCorePage(page.slug);
let previewPath = `/${page.slug}`;
if (page.slug === 'home') previewPath = '/';
else if (core?.path && !core.path.includes('{')) previewPath = core.path;
else if (page.slug === 'urun-sablon') previewPath = '/catalog';
else if (page.slug === 'yazi-sablon') previewPath = '/blog';
---

<BuilderLayout title={page.title}>
  <PageBuilder
    client:load
    mode="edit"
    slug={page.slug}
    previewPath={previewPath}
    sectionTypes={sectionTypes}
    pages={pages.map((p) => {
      const c = getCorePage(p.slug);
      return {
        slug: p.slug,
        title: c ? `${c.title}` : p.title,
        status: p.status,
        pathHint: c?.path ?? `/${p.slug}`,
      };
    })}
    initialPage={{
      id: page.id,
      slug: page.slug,
      title: page.title,
      status: page.status,
      sections: page.sections.map((s) => ({
        id: s.id,
        type: s.type,
        position: s.position,
        isVisible: s.isVisible,
        configJson: s.configJson,
      })),
    }}
  />
</BuilderLayout>
