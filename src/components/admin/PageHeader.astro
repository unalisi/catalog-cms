---
interface Props {
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <slot name="breadcrumb" />
    <h1 class="font-display text-2xl font-bold">{title}</h1>
    {description && <p class="mt-1 text-sm text-muted-foreground">{description}</p>}
  </div>
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="inline-flex rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
      >
        {actionLabel}
      </a>
    )
  }
</div>
