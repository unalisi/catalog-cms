---
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['faq'];
}

const { config } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
  {
    config.title && (
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
    )
  }
  <div class="mt-10 divide-y divide-border border-y border-border">
    {
      config.items.map((item) => (
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-medium marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              <span class="font-display text-base tracking-tight">{item.question}</span>
              <span
                class="shrink-0 text-muted-foreground transition group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </span>
          </summary>
          <p class="mt-4 max-w-prose text-sm leading-relaxed text-muted-foreground">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
