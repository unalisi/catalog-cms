---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostForm from '../../../components/admin/PostForm';
import { getAdminPost } from '../../../server/services/posts';

const { id } = Astro.params;
const data = id ? await getAdminPost(id) : null;
if (!data) {
  Astro.response.status = 404;
}
const post = data?.post;
const seo = data?.seo;
const cover = data?.cover;
---

<AdminLayout
  title={post ? `Düzenle · ${post.title}` : 'Yazı bulunamadı'}
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/blog', label: 'Blog' },
    { label: post?.title ?? 'Bulunamadı' },
  ]}
>
  {
    !post ? (
      <p>Yazı bulunamadı.</p>
    ) : (
      <div class="flex flex-col gap-4">
        <div>
          <h1 class="font-display text-2xl font-bold tracking-tight">{post.title}</h1>
        </div>
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <PostForm
            client:load
            mode="edit"
            postId={post.id}
            initial={{
              title: post.title,
              slug: post.slug,
              excerpt: post.excerpt ?? '',
              content: post.content,
              status: post.status,
              publishedAt: post.publishedAt ?? '',
              tags: post.tags.join(', '),
              coverMediaId: post.coverMediaId,
              coverMediaUrl: cover?.url ?? null,
              coverMediaKey: cover?.key ?? null,
              seo,
            }}
          />
        </div>
      </div>
    )
  }
</AdminLayout>
