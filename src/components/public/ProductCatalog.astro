---
import { formatMoney } from '../../lib/money';
import { stripHtmlToText } from '../../lib/html/sanitize-product-description';
import { getProductList, getCategories, getBrands } from '../../server/services/catalog';

interface Props {
  title?: string;
  showFilters?: boolean;
  pageSize?: number;
  layout?: 'grid' | 'row' | 'compact';
  columns?: number;
}

const {
  title = 'Katalog',
  showFilters = true,
  pageSize = 12,
  layout = 'grid',
  columns = 3,
} = Astro.props;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const brandSlug = Astro.url.searchParams.get('brand') ?? undefined;
const categorySlug = Astro.url.searchParams.get('category') ?? undefined;
const qRaw = Astro.url.searchParams.get('q')?.trim() ?? '';
const q = qRaw.slice(0, 100) || undefined;
const useFilters = showFilters && layout === 'grid';
const colClass = columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';

const [{ data: list, status }, { data: categories }, { data: brands }] = await Promise.all([
  getProductList({ page, pageSize, brandSlug, categorySlug, q }),
  getCategories(),
  getBrands(),
]);

const items = list?.items ?? [];
const total = list?.total ?? 0;
const totalPages = Math.max(1, Math.ceil(total / pageSize));

function filterQuery(overrides: Record<string, string | undefined> = {}) {
  const params = new URLSearchParams();
  const next = {
    brand: brandSlug,
    category: categorySlug,
    q,
    ...overrides,
  };
  if (next.category) params.set('category', next.category);
  if (next.brand) params.set('brand', next.brand);
  if (next.q) params.set('q', next.q);
  const qs = params.toString();
  return qs ? `/catalog?${qs}` : '/catalog';
}

function hrefFor(nextPage: number) {
  const params = new URLSearchParams();
  if (nextPage > 1) params.set('page', String(nextPage));
  if (categorySlug) params.set('category', categorySlug);
  if (brandSlug) params.set('brand', brandSlug);
  if (q) params.set('q', q);
  const qs = params.toString();
  return qs ? `/catalog?${qs}` : '/catalog';
}
---

<section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16" data-cache={status}>
  <div class="flex flex-col gap-3">
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <p class="text-muted-foreground">
      {total} ürün{q ? ` · “${q}”` : ''}
    </p>
    {
      useFilters && (
        <form method="get" action="/catalog" class="flex flex-col gap-2 sm:flex-row sm:items-center">
          {categorySlug && <input type="hidden" name="category" value={categorySlug} />}
          {brandSlug && <input type="hidden" name="brand" value={brandSlug} />}
          <label class="sr-only" for="catalog-q">Ürün ara</label>
          <input
            id="catalog-q"
            type="search"
            name="q"
            value={qRaw}
            placeholder="Ürün, SKU veya açıklama ara…"
            class="min-h-11 flex-1 rounded-md border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
          />
          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
          >
            Ara
          </button>
          {
            q && (
              <a
                href={filterQuery({ q: undefined })}
                class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-4 py-2 text-sm hover:bg-muted"
              >
                Temizle
              </a>
            )
          }
        </form>
      )
    }
  </div>

  <div class:list={['mt-8 flex flex-col gap-8', useFilters && 'lg:flex-row']}>
    {
      useFilters && (
        <aside class="w-full shrink-0 lg:w-56">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-muted-foreground">
            Filtreler
          </h2>
          <div class="mt-4 flex flex-col gap-6">
            <div>
              <p class="mb-2 text-sm font-medium">Kategori</p>
              <ul class="flex flex-col gap-1 text-sm">
                <li>
                  <a
                    href={filterQuery({ category: undefined })}
                    class:list={[
                      'hover:text-foreground',
                      !categorySlug ? 'font-semibold text-foreground' : 'text-muted-foreground',
                    ]}
                  >
                    Tümü
                  </a>
                </li>
                {(categories ?? []).map((cat) => (
                  <li>
                    <a
                      href={filterQuery({ category: cat.slug })}
                      class:list={[
                        'hover:text-foreground',
                        categorySlug === cat.slug
                          ? 'font-semibold text-foreground'
                          : 'text-muted-foreground',
                      ]}
                    >
                      {cat.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="mb-2 text-sm font-medium">Marka</p>
              <ul class="flex flex-col gap-1 text-sm">
                <li>
                  <a
                    href={filterQuery({ brand: undefined })}
                    class:list={[
                      'hover:text-foreground',
                      !brandSlug ? 'font-semibold text-foreground' : 'text-muted-foreground',
                    ]}
                  >
                    Tümü
                  </a>
                </li>
                {(brands ?? []).map((brand) => (
                  <li>
                    <a
                      href={filterQuery({ brand: brand.slug })}
                      class:list={[
                        'hover:text-foreground',
                        brandSlug === brand.slug
                          ? 'font-semibold text-foreground'
                          : 'text-muted-foreground',
                      ]}
                    >
                      {brand.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      )
    }

    <div class="min-w-0 flex-1">
      {
        items.length === 0 ? (
          <div class="rounded-md border border-dashed border-border bg-muted/30 px-6 py-16 text-center">
            <p class="font-display text-lg font-semibold">Ürün bulunamadı</p>
            <p class="mt-2 text-sm text-muted-foreground">Filtreleri temizleyip tekrar deneyin.</p>
            <a
              href="/catalog"
              class="mt-6 inline-flex rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground"
            >
              Tüm ürünler
            </a>
          </div>
        ) : layout === 'row' ? (
          <div class="flex flex-col gap-4">
            {items.map((product) => (
              <a
                href={`/product/${product.slug}`}
                class="group flex flex-col gap-4 border border-border transition-colors hover:border-primary sm:flex-row"
              >
                <div class="aspect-[4/3] shrink-0 overflow-hidden bg-muted sm:aspect-square sm:w-40">
                  {product.imageUrl ? (
                    <img
                      src={product.imageUrl}
                      alt=""
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center font-display text-sm text-muted-foreground">
                      {product.name.slice(0, 1)}
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-2 p-4 sm:py-4 sm:pr-4 sm:pl-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h2 class="font-display text-lg font-semibold group-hover:underline">
                      {product.name}
                    </h2>
                    <p class="font-mono text-base font-semibold text-primary">
                      {formatMoney(product.price, product.currency)}
                    </p>
                  </div>
                  {product.brand && (
                    <p class="text-sm text-muted-foreground">{product.brand.name}</p>
                  )}
                  {product.description && (
                    <p class="line-clamp-2 text-sm text-muted-foreground">
                      {stripHtmlToText(product.description)}
                    </p>
                  )}
                </div>
              </a>
            ))}
          </div>
        ) : layout === 'compact' ? (
          <ul class:list={['grid gap-3 sm:grid-cols-2', colClass]}>
            {items.map((product) => (
              <li>
                <a
                  href={`/product/${product.slug}`}
                  class="group flex h-full flex-col overflow-hidden border border-border transition-colors hover:border-primary"
                >
                  <div class="aspect-square overflow-hidden bg-muted">
                    {product.imageUrl ? (
                      <img
                        src={product.imageUrl}
                        alt=""
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center font-display text-sm text-muted-foreground">
                        {product.name.slice(0, 1)}
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-1 p-3">
                    <h2 class="font-display text-sm font-semibold leading-snug group-hover:underline">
                      {product.name}
                    </h2>
                    <p class="mt-auto font-mono text-sm font-semibold text-primary">
                      {formatMoney(product.price, product.currency)}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <ul class:list={['grid gap-4 sm:grid-cols-2', colClass]}>
            {items.map((product, i) => (
              <li>
                <a
                  href={`/product/${product.slug}`}
                  class="group flex h-full flex-col overflow-hidden border border-border transition-colors hover:border-primary"
                >
                  <div class="aspect-[4/3] overflow-hidden bg-muted">
                    {product.imageUrl ? (
                      <img
                        src={product.imageUrl}
                        alt=""
                        width={128}
                        height={96}
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                        loading={i < 6 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : 'auto'}
                        decoding="async"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center font-display text-sm text-muted-foreground">
                        {product.name.slice(0, 1)}
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-2 p-4">
                    <h2 class="text-base font-semibold tracking-tight group-hover:underline">
                      {product.name}
                    </h2>
                    {product.brand && (
                      <p class="text-xs text-muted-foreground">{product.brand.name}</p>
                    )}
                    <p class="mt-auto font-mono text-sm font-semibold text-primary">
                      {formatMoney(product.price, product.currency)}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        totalPages > 1 && (
          <nav aria-label="Sayfalama" class="mt-10 flex items-center justify-center gap-3">
            {page > 1 && (
              <a
                href={hrefFor(page - 1)}
                class="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
              >
                Önceki
              </a>
            )}
            <span class="text-sm text-muted-foreground">
              {page} / {totalPages}
            </span>
            {page < totalPages && (
              <a
                href={hrefFor(page + 1)}
                class="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
              >
                Sonraki
              </a>
            )}
          </nav>
        )
      }
    </div>
  </div>
</section>
