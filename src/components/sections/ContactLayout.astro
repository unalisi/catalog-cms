---
import type { SectionConfigMap } from '../../lib/sections/registry';
import ContactForm from './ContactForm';

interface Props {
  config: SectionConfigMap['contact-layout'];
}

const { config } = Astro.props;
const variant = config.variant ?? 'map-form';
const mapsSearch = config.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(config.address)}`
  : '';
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
  <div class="max-w-2xl">
    {
      config.title && (
        <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
      )
    }
    {config.subtitle && <p class="mt-3 text-muted-foreground">{config.subtitle}</p>}
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-2">
    {
      (variant === 'map-form' || variant === 'form-map') && (
        <>
          {variant === 'map-form' && (
            <>
              <div class="min-h-72 overflow-hidden border border-border bg-muted">
                {config.mapEmbedUrl ? (
                  <iframe
                    src={config.mapEmbedUrl}
                    title="Harita"
                    class="h-full min-h-72 w-full"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  />
                ) : (
                  <div class="flex h-full min-h-72 flex-col items-center justify-center gap-3 p-6 text-center text-sm text-muted-foreground">
                    <p>Harita embed URL tanımlı değil.</p>
                    {mapsSearch && (
                      <a
                        href={mapsSearch}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium hover:text-foreground"
                      >
                        Haritada aç →
                      </a>
                    )}
                  </div>
                )}
              </div>
              <div class="border border-border bg-background p-5 md:p-6">
                <ContactForm
                  client:load
                  title={config.formTitle}
                  submitLabel={config.formSubmitLabel}
                  successMessage={config.successMessage}
                />
              </div>
            </>
          )}
          {variant === 'form-map' && (
            <>
              <div class="border border-border bg-background p-5 md:p-6">
                <ContactForm
                  client:load
                  title={config.formTitle}
                  submitLabel={config.formSubmitLabel}
                  successMessage={config.successMessage}
                />
              </div>
              <div class="min-h-72 overflow-hidden border border-border bg-muted">
                {config.mapEmbedUrl ? (
                  <iframe
                    src={config.mapEmbedUrl}
                    title="Harita"
                    class="h-full min-h-72 w-full"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  />
                ) : (
                  <div class="flex h-full min-h-72 flex-col items-center justify-center gap-3 p-6 text-center text-sm text-muted-foreground">
                    <p>Harita embed URL tanımlı değil.</p>
                    {mapsSearch && (
                      <a
                        href={mapsSearch}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium hover:text-foreground"
                      >
                        Haritada aç →
                      </a>
                    )}
                  </div>
                )}
              </div>
            </>
          )}
        </>
      )
    }

    {
      (variant === 'info-form' || variant === 'form-info') && (
        <>
          {variant === 'info-form' && (
            <>
              <div class="flex flex-col gap-5 border border-border p-5 md:p-6">
                {config.address && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Adres
                    </p>
                    <p class="mt-2 text-base leading-relaxed">{config.address}</p>
                  </div>
                )}
                {config.phone && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Telefon
                    </p>
                    <a
                      href={`tel:${config.phone.replace(/[^\d+]/g, '')}`}
                      class="mt-2 inline-block hover:underline"
                    >
                      {config.phone}
                    </a>
                  </div>
                )}
                {config.email && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      E-posta
                    </p>
                    <a href={`mailto:${config.email}`} class="mt-2 inline-block hover:underline">
                      {config.email}
                    </a>
                  </div>
                )}
                {config.hours && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Çalışma saatleri
                    </p>
                    <p class="mt-2 text-sm text-muted-foreground">{config.hours}</p>
                  </div>
                )}
              </div>
              <div class="border border-border bg-background p-5 md:p-6">
                <ContactForm
                  client:load
                  title={config.formTitle}
                  submitLabel={config.formSubmitLabel}
                  successMessage={config.successMessage}
                />
              </div>
            </>
          )}
          {variant === 'form-info' && (
            <>
              <div class="border border-border bg-background p-5 md:p-6">
                <ContactForm
                  client:load
                  title={config.formTitle}
                  submitLabel={config.formSubmitLabel}
                  successMessage={config.successMessage}
                />
              </div>
              <div class="flex flex-col gap-5 border border-border p-5 md:p-6">
                {config.address && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Adres
                    </p>
                    <p class="mt-2 text-base leading-relaxed">{config.address}</p>
                  </div>
                )}
                {config.phone && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Telefon
                    </p>
                    <a
                      href={`tel:${config.phone.replace(/[^\d+]/g, '')}`}
                      class="mt-2 inline-block hover:underline"
                    >
                      {config.phone}
                    </a>
                  </div>
                )}
                {config.email && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      E-posta
                    </p>
                    <a href={`mailto:${config.email}`} class="mt-2 inline-block hover:underline">
                      {config.email}
                    </a>
                  </div>
                )}
                {config.hours && (
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Çalışma saatleri
                    </p>
                    <p class="mt-2 text-sm text-muted-foreground">{config.hours}</p>
                  </div>
                )}
              </div>
            </>
          )}
        </>
      )
    }
  </div>
</section>
