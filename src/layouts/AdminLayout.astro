---
import '../styles/global.css';
import { AdminShell } from '../components/admin/AdminShell';
import { Toaster } from '../components/ui/sonner';

interface Props {
  title?: string;
  breadcrumbs?: { href?: string; label: string }[];
}

const { title = 'Admin', breadcrumbs = [] } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user ?? null;
---

<!doctype html>
<html lang="tr" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Admin</title>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground">
    <a
      href="#admin-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    >
      İçeriğe geç
    </a>
    <AdminShell client:load pathname={pathname} title={title} breadcrumbs={breadcrumbs} user={user}>
      <slot />
    </AdminShell>
    <Toaster client:idle />
  </body>
</html>
