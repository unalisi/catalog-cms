---
import type { SectionConfigMap } from '../../lib/sections/registry';
import { getCategories } from '../../server/services/catalog';

interface Props {
  config: SectionConfigMap['category-grid'];
}

const { config } = Astro.props;
const { data: categories } = await getCategories();
const cols =
  config.columns === 4
    ? 'md:grid-cols-4'
    : config.columns === 3
      ? 'md:grid-cols-3'
      : 'md:grid-cols-2';
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
  {
    config.title && (
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
    )
  }
  <div class={`mt-10 grid gap-4 sm:grid-cols-2 ${cols}`}>
    {
      (categories ?? []).length === 0 ? (
        <p class="text-sm text-muted-foreground">Kategori yok.</p>
      ) : (
        (categories ?? []).map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="group relative flex min-h-40 flex-col justify-end overflow-hidden border border-border bg-muted transition-colors hover:border-primary"
          >
            {cat.imageUrl ? (
              <img
                src={cat.imageUrl}
                alt=""
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                loading="lazy"
              />
            ) : null}
            <div
              class:list={[
                'relative z-10 p-5',
                cat.imageUrl
                  ? 'bg-gradient-to-t from-foreground/75 via-foreground/35 to-transparent'
                  : '',
              ]}
            >
              <span
                class:list={[
                  'font-display text-lg font-semibold tracking-tight',
                  cat.imageUrl ? 'text-background' : 'text-foreground',
                ]}
              >
                {cat.name}
              </span>
              {cat.description && !cat.imageUrl ? (
                <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{cat.description}</p>
              ) : null}
            </div>
          </a>
        ))
      )
    }
  </div>
</section>
