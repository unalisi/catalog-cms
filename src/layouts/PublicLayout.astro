---
import '../styles/global.css';
import type { PageSeo } from '../lib/seo/meta';
import {
  DEFAULT_SITE_SETTINGS,
  type NavbarLayout,
} from '../lib/validation/settings';
import { parseNavigation } from '../lib/navigation/nav';
import { getCachedSiteSettings } from '../server/services/settings';
import { resolveNavForPublic } from '../server/services/nav';
import SiteNavbar from '../components/public/navbar/SiteNavbar';

interface Props {
  title?: string;
  description?: string;
  seo?: PageSeo;
  noindex?: boolean;
  cacheStatus?: 'HIT' | 'MISS' | null;
  jsonLd?: string | null;
}

const {
  title = 'Catalog CMS',
  description = 'Ürün katalog ve içerik yönetim sistemi',
  seo,
  noindex = false,
  cacheStatus = null,
  jsonLd = null,
} = Astro.props;

const { data: site } = await getCachedSiteSettings();
const siteName = site?.name ?? 'Catalog CMS';
const nav = await resolveNavForPublic(
  parseNavigation(site?.navigation ?? DEFAULT_SITE_SETTINGS.navigation),
);
const navbarLayout = (site?.navbarLayout ?? 'classic') as NavbarLayout;
const navbarCtas = site?.navbarCtas?.length
  ? site.navbarCtas
  : DEFAULT_SITE_SETTINGS.navbarCtas;
const favicon = site?.faviconUrl || '/favicon.svg';
const logoUrl = site?.logoUrl ?? null;
const logoAlt = site?.logoAlt ?? siteName;
const footerText = site?.footerText || `© ${new Date().getFullYear()} ${siteName}`;
const gaId = site?.analytics?.gaMeasurementId?.trim() || null;

const pageTitle = seo?.title ?? title;
const pageDescription = seo?.description ?? description;
const canonical = seo?.canonical;
const robots =
  seo?.robots ?? (seo?.noindex || noindex ? 'noindex, nofollow' : undefined);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={seo?.ogTitle ?? pageTitle} />
    <meta property="og:description" content={seo?.ogDescription ?? pageDescription} />
    <meta property="og:type" content={seo?.ogType ?? 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {seo?.ogImage && <meta property="og:image" content={seo.ogImage} />}
    <meta name="twitter:card" content={seo?.twitterCard ?? 'summary'} />
    <meta name="twitter:title" content={seo?.twitterTitle ?? pageTitle} />
    <meta name="twitter:description" content={seo?.twitterDescription ?? pageDescription} />
    {seo?.twitterImage && <meta name="twitter:image" content={seo.twitterImage} />}
    {seo?.twitterSite && <meta name="twitter:site" content={seo.twitterSite} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{pageTitle}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {
      gaId && (
        <script
          is:inline
          set:html={`
            (function(){
              var s=document.createElement('script');
              s.async=true;
              s.src='https://www.googletagmanager.com/gtag/js?id=${gaId}';
              document.head.appendChild(s);
              window.dataLayer=window.dataLayer||[];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${gaId}');
            })();
          `}
        />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    >
      İçeriğe geç
    </a>
    <SiteNavbar
      client:idle
      siteName={siteName}
      logoUrl={logoUrl}
      logoAlt={logoAlt}
      layout={navbarLayout}
      items={nav}
      ctas={navbarCtas}
    />
    <main id="main" class="flex-1" data-cache={cacheStatus ?? undefined}>
      <slot />
    </main>
    <footer class="mt-auto border-t border-border">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-muted-foreground md:px-6">
        <p>{footerText}</p>
        {
          site?.contactEmail && (
            <p class="mt-2">
              <a href={`mailto:${site.contactEmail}`} class="hover:text-foreground">
                {site.contactEmail}
              </a>
            </p>
          )
        }
      </div>
    </footer>
  </body>
</html>
