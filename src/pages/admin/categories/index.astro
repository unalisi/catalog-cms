---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import DeleteButton from '../../../components/admin/DeleteButton';
import { getDb } from '../../../server/db';
import { listAllCategories } from '../../../server/repos/admin';
import type { Category } from '../../../../db/schema';

const categories: Category[] = await listAllCategories(getDb());
const byId = new Map<string, Category>(categories.map((c) => [c.id, c]));
---

<AdminLayout
  title="Kategoriler"
  breadcrumbs={[{ href: '/admin', label: 'Admin' }, { label: 'Kategoriler' }]}
>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight">Kategoriler</h1>
        <p class="mt-1 text-sm text-muted-foreground">{categories.length} kayıt</p>
      </div>
      <a
        href="/admin/categories/new"
        class="inline-flex rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
      >
        Yeni kategori
      </a>
    </div>

    {
      categories.length === 0 ? (
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <EmptyState
            title="Henüz kategori yok"
            description="Ağaç yapı için üst kategori seçerek oluşturabilirsiniz."
            actionHref="/admin/categories/new"
            actionLabel="Kategori ekle"
          />
        </div>
      ) : (
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[44rem] text-left text-sm">
              <thead class="bg-muted">
                <tr>
                  <th class="px-3 py-2 font-medium">Ad</th>
                  <th class="px-3 py-2 font-medium">Slug</th>
                  <th class="px-3 py-2 font-medium">Üst</th>
                  <th class="px-3 py-2 font-medium">Sıra</th>
                  <th class="px-3 py-2 font-medium">Durum</th>
                  <th class="px-3 py-2 font-medium">İşlem</th>
                </tr>
              </thead>
              <tbody>
                {categories.map((category) => (
                  <tr class="border-t border-border hover:bg-muted/40">
                    <td class="px-3 py-2 font-medium">{category.name}</td>
                    <td class="px-3 py-2 font-mono text-muted-foreground">{category.slug}</td>
                    <td class="px-3 py-2 text-muted-foreground">
                      {category.parentId ? (byId.get(category.parentId)?.name ?? '—') : '—'}
                    </td>
                    <td class="px-3 py-2 font-mono">{category.position}</td>
                    <td class="px-3 py-2">{category.status}</td>
                    <td class="px-3 py-2">
                      <div class="flex items-center gap-3">
                        <a href={`/admin/categories/${category.id}`} class="hover:underline">
                          Düzenle
                        </a>
                        <DeleteButton client:load endpoint={`/api/admin/categories/${category.id}`} />
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>
</AdminLayout>
