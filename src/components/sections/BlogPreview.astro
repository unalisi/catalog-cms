---
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['blog-preview'];
}

const { config } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  <h2 class="font-display text-2xl font-bold">{config.title}</h2>
  <p class="mt-4 text-sm text-muted-foreground">
    Blog yazıları FAZ 6’da eklenecek. Limit: {config.limit}.
  </p>
</section>
