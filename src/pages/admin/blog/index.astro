---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import DeleteButton from '../../../components/admin/DeleteButton';
import { listAdminPosts } from '../../../server/services/posts';

const posts = await listAdminPosts();
const toast = Astro.url.searchParams.get('toast');
const now = Date.now();

function statusLabel(status: string, publishedAt: string | null) {
  if (status === 'published' && publishedAt && Date.parse(publishedAt) > now) {
    return 'planlı';
  }
  return status;
}
---

<AdminLayout
  title="Blog"
  breadcrumbs={[{ href: '/admin', label: 'Admin' }, { label: 'Blog' }]}
>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-display text-2xl font-bold">Blog</h1>
      <p class="mt-1 text-sm text-muted-foreground">{posts.length} yazı</p>
    </div>
    <a
      href="/admin/blog/new"
      class="inline-flex rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
    >
      Yeni yazı
    </a>
  </div>

  {
    toast === 'saved' && (
      <p class="mb-4 rounded-md border border-border bg-muted/40 px-3 py-2 text-sm">Yazı kaydedildi.</p>
    )
  }

  {
    posts.length === 0 ? (
      <EmptyState
        title="Henüz yazı yok"
        description="İlk blog yazısını oluşturun. İçerik sanitize edilmiş HTML olarak saklanır."
        actionHref="/admin/blog/new"
        actionLabel="Yazı ekle"
      />
    ) : (
      <div class="overflow-x-auto rounded-md border border-border">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead class="bg-muted">
            <tr>
              <th class="px-3 py-2 font-medium">Başlık</th>
              <th class="px-3 py-2 font-medium">Slug</th>
              <th class="px-3 py-2 font-medium">Durum</th>
              <th class="px-3 py-2 font-medium">Yayın</th>
              <th class="px-3 py-2 font-medium">Etiket</th>
              <th class="px-3 py-2 font-medium">İşlem</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr class="border-t border-border hover:bg-muted/40">
                <td class="px-3 py-2 font-medium">{post.title}</td>
                <td class="px-3 py-2 font-mono text-muted-foreground">{post.slug}</td>
                <td class="px-3 py-2">{statusLabel(post.status, post.publishedAt)}</td>
                <td class="px-3 py-2 text-muted-foreground">
                  {post.publishedAt ? new Date(post.publishedAt).toLocaleString('tr-TR') : '—'}
                </td>
                <td class="px-3 py-2 text-muted-foreground">{post.tags.join(', ') || '—'}</td>
                <td class="px-3 py-2">
                  <div class="flex items-center gap-3">
                    <a href={`/admin/blog/${post.id}`} class="hover:underline">
                      Düzenle
                    </a>
                    <DeleteButton client:load endpoint={`/api/admin/posts/${post.id}`} />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
