---
import Hero from './Hero.astro';
import FeaturedProducts from './FeaturedProducts.astro';
import BrandStrip from './BrandStrip.astro';
import CategoryGrid from './CategoryGrid.astro';
import WhyUs from './WhyUs.astro';
import ContactChannels from './ContactChannels.astro';
import References from './References.astro';
import BannerCta from './BannerCta.astro';
import BlogPreview from './BlogPreview.astro';
import MapContact from './MapContact.astro';
import Faq from './Faq.astro';
import RichText from './RichText.astro';
import Gallery from './Gallery.astro';
import WhatsAppFloatSection from './WhatsAppFloat.astro';
import ContactLayout from './ContactLayout.astro';
import ProductList from './ProductList.astro';
import BlogList from './BlogList.astro';
import ProductDetail from './ProductDetail.astro';
import RelatedProducts from './RelatedProducts.astro';
import RelatedPosts from './RelatedPosts.astro';
import {
  isSectionType,
  parseConfigJson,
  type SectionConfigMap,
  type SectionType,
} from '../../lib/sections/registry';
import type { ProductDetail as ProductDetailData } from '../../server/repos/catalog';

export type RenderSection = {
  id: string;
  type: string;
  configJson: string;
};

interface Props {
  sections: RenderSection[];
  product?: ProductDetailData | null;
}

const { sections, product = null } = Astro.props;

function typedConfig<T extends SectionType>(type: T, configJson: string): SectionConfigMap[T] {
  return parseConfigJson(type, configJson) as SectionConfigMap[T];
}
---

{
  sections.map((section) => {
    if (!isSectionType(section.type)) return null;
    switch (section.type) {
      case 'hero':
        return <Hero config={typedConfig('hero', section.configJson)} />;
      case 'featured-products':
        return (
          <FeaturedProducts config={typedConfig('featured-products', section.configJson)} />
        );
      case 'brand-strip':
        return <BrandStrip config={typedConfig('brand-strip', section.configJson)} />;
      case 'category-grid':
        return <CategoryGrid config={typedConfig('category-grid', section.configJson)} />;
      case 'why-us':
        return <WhyUs config={typedConfig('why-us', section.configJson)} />;
      case 'contact-channels':
        return <ContactChannels config={typedConfig('contact-channels', section.configJson)} />;
      case 'references':
        return <References config={typedConfig('references', section.configJson)} />;
      case 'banner-cta':
        return <BannerCta config={typedConfig('banner-cta', section.configJson)} />;
      case 'blog-preview':
        return <BlogPreview config={typedConfig('blog-preview', section.configJson)} />;
      case 'map-contact':
        return <MapContact config={typedConfig('map-contact', section.configJson)} />;
      case 'faq':
        return <Faq config={typedConfig('faq', section.configJson)} />;
      case 'rich-text':
        return (
          <RichText
            sectionId={section.id}
            config={typedConfig('rich-text', section.configJson)}
          />
        );
      case 'gallery':
        return <Gallery config={typedConfig('gallery', section.configJson)} />;
      case 'whatsapp-float':
        return <WhatsAppFloatSection config={typedConfig('whatsapp-float', section.configJson)} />;
      case 'contact-layout':
        return <ContactLayout config={typedConfig('contact-layout', section.configJson)} />;
      case 'product-list':
        return <ProductList config={typedConfig('product-list', section.configJson)} />;
      case 'blog-list':
        return <BlogList config={typedConfig('blog-list', section.configJson)} />;
      case 'product-detail':
        return (
          <ProductDetail
            config={typedConfig('product-detail', section.configJson)}
            product={product}
          />
        );
      case 'related-products':
        return <RelatedProducts config={typedConfig('related-products', section.configJson)} />;
      case 'related-posts':
        return <RelatedPosts config={typedConfig('related-posts', section.configJson)} />;
      default:
        return null;
    }
  })
}
