---
import '../styles/global.css';

interface Props {
  title?: string;
  breadcrumbs?: { href?: string; label: string }[];
}

const { title = 'Admin', breadcrumbs = [] } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user;

const nav = [
  { href: '/admin', label: 'Dashboard', exact: true },
  { href: '/admin/products', label: 'Ürünler' },
  { href: '/admin/brands', label: 'Markalar' },
  { href: '/admin/categories', label: 'Kategoriler' },
  { href: '/admin/pages', label: 'Sayfalar' },
  { href: '/admin/seo', label: 'SEO' },
  { href: '/admin/blog', label: 'Blog' },
  { href: '/admin/import', label: 'İçe aktarım' },
  { href: '/admin/media', label: 'Medya' },
  { href: '/admin/settings', label: 'Ayarlar' },
];

function isActive(href: string, exact = false) {
  if (exact) return pathname === href;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Admin</title>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <a
      href="#admin-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    >
      İçeriğe geç
    </a>
    <div class="flex min-h-dvh">
      <aside class="hidden w-64 shrink-0 border-r border-border bg-muted/40 md:block">
        <div class="border-b border-border px-4 py-4">
          <a href="/admin" class="font-display text-lg font-bold">Catalog Admin</a>
        </div>
        <nav aria-label="Admin menü" class="flex flex-col gap-1 p-3">
          {
            nav.map((item) => {
              const active = isActive(item.href, item.exact);
              return (
                <a
                  href={item.href}
                  class:list={[
                    'rounded-md px-3 py-2 text-sm font-medium',
                    active
                      ? 'border-l-2 border-primary bg-primary/10 text-foreground'
                      : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </aside>
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="border-b border-border px-4 py-3 md:px-6">
          <div class="flex items-center justify-between gap-4">
            <div class="min-w-0">
              {
                breadcrumbs.length > 0 && (
                  <nav aria-label="Breadcrumb" class="mb-1">
                    <ol class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                      {breadcrumbs.map((item, index) => (
                        <li class="flex items-center gap-2">
                          {index > 0 && <span aria-hidden="true">/</span>}
                          {item.href ? (
                            <a href={item.href} class="hover:text-foreground">
                              {item.label}
                            </a>
                          ) : (
                            <span class="text-foreground">{item.label}</span>
                          )}
                        </li>
                      ))}
                    </ol>
                  </nav>
                )
              }
              <p class="truncate text-sm text-muted-foreground">{user?.email ?? 'Admin'}</p>
            </div>
            <div class="flex items-center gap-3">
              <a href="/" class="text-sm text-muted-foreground hover:text-foreground">Siteye dön</a>
              <form method="POST" action="/api/admin/auth/logout">
                <button
                  type="submit"
                  class="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
                >
                  Çıkış
                </button>
              </form>
            </div>
          </div>
        </header>
        <main id="admin-main" class="flex-1 p-4 md:p-6" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
