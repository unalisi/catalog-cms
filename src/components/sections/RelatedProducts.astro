---
import { formatMoney } from '../../lib/money';
import type { SectionConfigMap } from '../../lib/sections/registry';
import { getProductList } from '../../server/services/catalog';

interface Props {
  config: SectionConfigMap['related-products'];
}

const { config } = Astro.props;
const limit = Math.min(12, Math.max(2, config.limit ?? 4));
const layout = config.layout ?? 'grid';
const { data } = await getProductList({ pageSize: limit });
const items = data?.items ?? [];
---

<section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
  <div class="flex items-end justify-between gap-4">
    <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
    <a href="/catalog" class="text-sm font-medium text-muted-foreground hover:text-foreground">
      Tümü
    </a>
  </div>

  {
    items.length === 0 ? (
      <p class="mt-10 text-sm text-muted-foreground">Henüz ürün yok.</p>
    ) : layout === 'row' ? (
      <ul class="mt-10 flex flex-col gap-4">
        {items.map((product) => (
          <li>
            <a
              href={`/product/${product.slug}`}
              class="group flex flex-col gap-4 border border-border transition-colors hover:border-primary sm:flex-row"
            >
              <div class="aspect-[4/3] shrink-0 overflow-hidden bg-muted sm:aspect-square sm:w-36">
                {product.imageUrl ? (
                  <img
                    src={product.imageUrl}
                    alt=""
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center font-display text-sm text-muted-foreground">
                    {product.name.slice(0, 1)}
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col gap-2 p-4 sm:py-4 sm:pr-4 sm:pl-0">
                <h3 class="font-display text-base font-semibold group-hover:underline">
                  {product.name}
                </h3>
                {product.brand && (
                  <p class="text-xs text-muted-foreground">{product.brand.name}</p>
                )}
                <p class="mt-auto font-mono text-sm font-semibold text-primary">
                  {formatMoney(product.price, product.currency)}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {items.map((product) => (
          <li>
            <a
              href={`/product/${product.slug}`}
              class="group flex h-full flex-col overflow-hidden border border-border transition-colors hover:border-primary"
            >
              <div class="aspect-[4/3] overflow-hidden bg-muted">
                {product.imageUrl ? (
                  <img
                    src={product.imageUrl}
                    alt=""
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center font-display text-sm text-muted-foreground">
                    {product.name.slice(0, 1)}
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col gap-2 p-4">
                <h3 class="font-display text-base font-semibold tracking-tight">{product.name}</h3>
                {product.brand && (
                  <p class="text-xs text-muted-foreground">{product.brand.name}</p>
                )}
                <p class="mt-auto font-mono text-sm font-semibold text-primary">
                  {formatMoney(product.price, product.currency)}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
