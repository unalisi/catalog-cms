---
interface Props {
  code: '404' | '500';
  title: string;
  message: string;
}

const { code, title, message } = Astro.props;
const isServerError = code === '500';
---

<section
  class="flex w-full max-w-lg flex-col items-center text-center"
  role={isServerError ? 'alert' : undefined}
>
  <p
    class="font-display text-6xl font-bold tracking-tight text-muted-foreground/40 sm:text-7xl"
    aria-hidden="true"
  >
    {code}
  </p>
  <h1 class="mt-4 font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
    {title}
  </h1>
  <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
    {message}
  </p>

  {/* Future: wire to category–product search (data-future="catalog-search") */}
  <div class="mt-12 w-full" data-future="catalog-search">
    <p class="mb-3 text-left text-sm font-medium text-foreground">
      Başka bir şeyler arayın:
    </p>
    <div class="relative">
      <label for={`error-search-${code}`} class="sr-only">Ara</label>
      <input
        id={`error-search-${code}`}
        type="search"
        name="q"
        placeholder="Ürün veya kategori…"
        disabled
        aria-disabled="true"
        tabindex="-1"
        class="min-h-11 w-full cursor-not-allowed rounded-md border border-border bg-muted/40 px-3 py-2 text-sm text-muted-foreground placeholder:text-muted-foreground/70"
      />
    </div>
  </div>

    <a
    href="/"
    class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground hover:opacity-90"
  >
    Ana sayfaya dön
  </a>
</section>
