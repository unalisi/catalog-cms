---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageEditor from '../../../components/admin/PageEditor';
import { getAdminPage, listSectionTypeOptions } from '../../../server/services/pages';

const slug = Astro.params.slug;
if (!slug) return Astro.redirect('/admin/pages');

const page = await getAdminPage(slug);
if (!page) return Astro.redirect('/admin/pages');

const sectionTypes = listSectionTypeOptions();
const previewPath = page.slug === 'home' ? '/' : `/${page.slug}`;
---

<AdminLayout
  title={page.title}
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/pages', label: 'Sayfalar' },
    { label: page.title },
  ]}
>
  <h1 class="mb-4 font-display text-2xl font-bold">{page.title}</h1>
  <p class="mb-6 text-sm text-muted-foreground">
    Sürükle-bırak ile sıralayın · görünürlük · tip formları · sağda iframe önizleme
  </p>
  <PageEditor
    client:load
    slug={page.slug}
    previewPath={previewPath}
    sectionTypes={sectionTypes}
    initialPage={{
      id: page.id,
      slug: page.slug,
      title: page.title,
      status: page.status,
      sections: page.sections.map((s) => ({
        id: s.id,
        type: s.type,
        position: s.position,
        isVisible: s.isVisible,
        configJson: s.configJson,
      })),
    }}
  />
</AdminLayout>
