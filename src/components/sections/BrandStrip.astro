---
import type { SectionConfigMap } from '../../lib/sections/registry';
import { getBrands } from '../../server/services/catalog';

interface Props {
  config: SectionConfigMap['brand-strip'];
}

const { config } = Astro.props;
const { data: brands } = await getBrands();
const items = [...(brands ?? [])].sort((a, b) => {
  const aLogo = a.logoUrl ? 0 : 1;
  const bLogo = b.logoUrl ? 0 : 1;
  if (aLogo !== bLogo) return aLogo - bLogo;
  return a.name.localeCompare(b.name, 'tr');
});
---

<section class="border-y border-border bg-muted/40" data-brand-strip>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
    {
      config.title && (
        <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
      )
    }
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {
        items.length === 0 ? (
          <li class="col-span-full text-sm text-muted-foreground">Marka yok.</li>
        ) : (
          items.map((brand) => (
            <li>
              <a
                href={`/brand/${brand.slug}`}
                class="group flex h-24 items-center justify-center border border-border bg-background px-4 transition-colors hover:border-primary"
                title={brand.name}
              >
                {brand.logoUrl ? (
                  <>
                    <img
                      src={brand.logoUrl}
                      alt={brand.name}
                      width="128"
                      height="48"
                      class="brand-logo max-h-12 max-w-full object-contain opacity-90 transition group-hover:opacity-100"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="brand-logo-fallback hidden font-display text-sm font-semibold tracking-tight text-muted-foreground">
                      {brand.name}
                    </span>
                  </>
                ) : (
                  <span class="font-display text-sm font-semibold tracking-tight text-muted-foreground">
                    {brand.name}
                  </span>
                )}
              </a>
            </li>
          ))
        )
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-brand-strip] img.brand-logo').forEach((img) => {
    const showFallback = () => {
      img.classList.add('hidden');
      img.nextElementSibling?.classList.remove('hidden');
    };
    if (img.complete && img.naturalWidth === 0) showFallback();
    img.addEventListener('error', showFallback);
  });
</script>
