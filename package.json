{
  "name": "catalog-cms",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "astro check && tsc --noEmit",
    "cf:setup": "node scripts/cf-setup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./db/seed.sql",
    "db:seed:grid:generate": "node scripts/generate-grid-seed.mjs",
    "db:seed:grid:local": "node scripts/generate-grid-seed.mjs && wrangler d1 execute DB --local --file=./db/seed-grid.sql",
    "db:seed:grid:remote": "node scripts/generate-grid-seed.mjs && wrangler d1 execute DB --remote --file=./db/seed-grid.sql",
    "db:seed:pages:local": "wrangler d1 execute DB --local --file=./db/seed-pages.sql",
    "db:seed:pages:remote": "wrangler d1 execute DB --remote --file=./db/seed-pages.sql",
    "db:seed:seo:local": "wrangler d1 execute DB --local --file=./db/seed-seo.sql",
    "db:seed:seo:remote": "wrangler d1 execute DB --remote --file=./db/seed-seo.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/react": "^6.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.4",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.114.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
