---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageForm from '../../../components/admin/PageForm';
---

<AdminLayout
  title="Yeni sayfa"
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/pages', label: 'Sayfalar' },
    { label: 'Yeni' },
  ]}
>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-display text-2xl font-bold tracking-tight">Yeni sayfa</h1>
    </div>
    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <PageForm client:load />
    </div>
  </div>
</AdminLayout>
