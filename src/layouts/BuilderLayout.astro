---
import '../styles/global.css';
import { Toaster } from '../components/ui/sonner';

interface Props {
  title?: string;
}

const { title = 'Sayfa düzenleyici' } = Astro.props;
---

<!doctype html>
<html lang="tr" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Builder</title>
  </head>
  <body class="h-dvh overflow-hidden bg-background font-sans text-foreground">
    <div class="h-full">
      <slot />
    </div>
    <Toaster client:idle />
  </body>
</html>
