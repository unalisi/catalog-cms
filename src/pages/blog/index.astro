---
import PublicLayout from '../../layouts/PublicLayout.astro';
import SectionRenderer from '../../components/sections/SectionRenderer.astro';
import BlogListing from '../../components/public/BlogListing.astro';
import { buildPageSeo } from '../../lib/seo/meta';
import { getPublishedPage } from '../../server/services/pages';
import { getSeoDefaults } from '../../server/services/seo';

export const prerender = false;

const origin = Astro.url.origin;
const tag = Astro.url.searchParams.get('tag') ?? undefined;
const [{ data: page, status }, { data: defaults }] = await Promise.all([
  getPublishedPage('blog'),
  getSeoDefaults(),
]);

const seo = buildPageSeo({
  title: page?.seo?.title || page?.title || (tag ? `Blog · ${tag}` : 'Blog'),
  description:
    page?.seo?.description ||
    (tag ? `${tag} etiketli yazılar` : 'Catalog CMS blog yazıları — ürün ve yayın notları.'),
  path: tag ? `/blog?tag=${encodeURIComponent(tag)}` : '/blog',
  origin,
  seoTitle: page?.seo?.title,
  seoDescription: page?.seo?.description,
  canonical: page?.seo?.canonical,
  noindex: page?.seo?.noindex,
  robotsExtra: page?.seo?.robotsExtra,
  ogImageUrl: page?.seo?.ogImageUrl,
  defaults: defaults!,
});

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('X-Cache', status);
---

<PublicLayout seo={seo} cacheStatus={status}>
  {
    page && page.sections.length > 0 ? (
      <SectionRenderer sections={page.sections} />
    ) : (
      <BlogListing title="Blog" />
    )
  }
</PublicLayout>
