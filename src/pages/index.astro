---
import PublicLayout from '../layouts/PublicLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import { buildPageSeo } from '../lib/seo/meta';
import {
  organizationJsonLd,
  stringifyJsonLd,
  websiteJsonLd,
} from '../lib/seo/jsonld';
import { getPublishedPage } from '../server/services/pages';
import { getSeoDefaults } from '../server/services/seo';

const origin = Astro.url.origin;
const [{ data: page, status }, { data: defaults }] = await Promise.all([
  getPublishedPage('home'),
  getSeoDefaults(),
]);
const seoDefaults = defaults!;

if (!page) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const seo = buildPageSeo({
  title: page.title,
  description: seoDefaults.defaultDescription,
  path: '/',
  origin,
  seoTitle: page.seo?.title,
  seoDescription: page.seo?.description,
  canonical: page.seo?.canonical,
  noindex: page.seo?.noindex,
  robotsExtra: page.seo?.robotsExtra,
  ogImageUrl: page.seo?.ogImageUrl,
  defaults: seoDefaults,
  isHome: true,
});

const jsonLd = stringifyJsonLd([
  organizationJsonLd(origin, seoDefaults),
  websiteJsonLd(origin, seoDefaults),
]);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('X-Cache', status);
---

<PublicLayout seo={seo} cacheStatus={status} jsonLd={jsonLd}>
  <SectionRenderer sections={page.sections} />
</PublicLayout>
