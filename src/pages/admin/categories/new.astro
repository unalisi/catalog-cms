---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../components/admin/CategoryForm';
import { getDb } from '../../../server/db';
import { listAllCategories } from '../../../server/repos/admin';

const parents = (await listAllCategories(getDb())).map((c) => ({ id: c.id, name: c.name }));
---

<AdminLayout
  title="Yeni kategori"
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/categories', label: 'Kategoriler' },
    { label: 'Yeni' },
  ]}
>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-display text-2xl font-bold tracking-tight">Yeni kategori</h1>
    </div>
    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <CategoryForm client:load mode="create" parents={parents} />
    </div>
  </div>
</AdminLayout>
