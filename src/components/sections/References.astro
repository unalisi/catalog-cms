---
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['references'];
}

const { config } = Astro.props;
const logos = config.logos ?? [];
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
  {
    config.title && (
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
    )
  }
  <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
    {
      logos.length === 0 ? (
        <li class="col-span-full text-sm text-muted-foreground">Referans yok.</li>
      ) : (
        logos.map((logo) => {
          const inner = (
            <span class="flex h-24 items-center justify-center border border-border bg-background px-3 transition-colors hover:border-primary">
              <img
                src={logo.src}
                alt={logo.alt || ''}
                class="max-h-12 max-w-full object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0"
                loading="lazy"
              />
            </span>
          );
          return (
            <li>
              {logo.href ? (
                <a href={logo.href} rel="noopener noreferrer">
                  {inner}
                </a>
              ) : (
                inner
              )}
            </li>
          );
        })
      )
    }
  </ul>
</section>
