---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import DeleteButton from '../../../components/admin/DeleteButton';
import { StatusDot } from '../../../components/admin/StatusDot';
import { getDb } from '../../../server/db';
import { listAllBrands } from '../../../server/repos/admin';
import type { Brand } from '../../../../db/schema';

const brands: Brand[] = await listAllBrands(getDb());
---

<AdminLayout
  title="Markalar"
  breadcrumbs={[{ href: '/admin', label: 'Panel' }, { label: 'Markalar' }]}
>
  <div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground">{brands.length} marka listeleniyor</p>
      <a
        href="/admin/brands/new"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-foreground hover:opacity-90"
      >
        <span aria-hidden="true">+</span>
        Marka Ekle
      </a>
    </div>

    {
      brands.length === 0 ? (
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <EmptyState
            title="Henüz marka yok"
            description="İlk markayı oluşturarak kataloğu yapılandırın."
            actionHref="/admin/brands/new"
            actionLabel="Marka ekle"
          />
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {brands.map((brand) => (
            <div class="rounded-lg border border-border bg-background p-4">
              <div class="mb-3 flex items-start justify-between gap-3">
                <div class="flex size-10 items-center justify-center rounded-md bg-primary-soft text-sm font-semibold text-primary">
                  {brand.name.slice(0, 2).toUpperCase()}
                </div>
                <StatusDot status={brand.status} />
              </div>
              <div class="text-sm font-semibold text-foreground">{brand.name}</div>
              <div class="mt-0.5 font-mono text-xs text-faint">{brand.slug}</div>
              <div class="mt-3 flex items-center gap-3 border-t border-border pt-3">
                <a
                  href={`/admin/brands/${brand.id}`}
                  class="text-xs font-medium text-primary hover:underline"
                >
                  Düzenle
                </a>
                <DeleteButton client:load endpoint={`/api/admin/brands/${brand.id}`} />
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</AdminLayout>
