---
import GalleryLightbox from './GalleryLightbox';
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['gallery'];
}

const { config } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  {config.title && <h2 class="mb-6 font-display text-2xl font-bold">{config.title}</h2>}
  <GalleryLightbox client:visible images={config.images} />
</section>
