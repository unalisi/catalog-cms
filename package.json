{
  "name": "catalog-cms",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "astro check && tsc --noEmit",
    "lint:design": "node scripts/check-design.mjs",
    "db:backup:local": "node scripts/db-backup.mjs --local",
    "db:backup:remote": "node scripts/db-backup.mjs --remote",
    "db:restore:test": "node scripts/db-restore-test.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./db/seed.sql",
    "db:seed:grid:generate": "node scripts/generate-grid-seed.mjs",
    "db:seed:grid:local": "node scripts/generate-grid-seed.mjs && wrangler d1 execute DB --local --file=./db/seed-grid.sql",
    "db:seed:grid:remote": "node scripts/generate-grid-seed.mjs && wrangler d1 execute DB --remote --file=./db/seed-grid.sql",
    "db:purge-grid:remote": "wrangler d1 execute DB --remote --file=./db/purge-grid-products.sql",
    "scrape:efor-telsiz": "node scripts/scrape-efor-telsiz.mjs",
    "ingest:efor-telsiz": "node scripts/ingest-efor-telsiz.mjs",
    "db:seed:pages:local": "wrangler d1 execute DB --local --file=./db/seed-pages.sql",
    "db:seed:pages:remote": "wrangler d1 execute DB --remote --file=./db/seed-pages.sql",
    "db:seed:seo:local": "wrangler d1 execute DB --local --file=./db/seed-seo.sql",
    "db:seed:seo:remote": "wrangler d1 execute DB --remote --file=./db/seed-seo.sql",
    "db:seed:blog:local": "wrangler d1 execute DB --local --file=./db/seed-blog.sql",
    "db:seed:blog:remote": "wrangler d1 execute DB --remote --file=./db/seed-blog.sql",
    "db:seed:settings:local": "wrangler d1 execute DB --local --file=./db/seed-settings.sql",
    "db:seed:settings:remote": "wrangler d1 execute DB --remote --file=./db/seed-settings.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/react": "^6.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.8",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.114.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
