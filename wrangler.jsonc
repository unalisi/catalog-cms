{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-cms",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog-db",
      "database_id": "93c9c5cc-6651-4dda-95f7-0fa610b85f67",
      "migrations_dir": "db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "61980cf442cd4804b76558e33769caa9"
    },
    {
      "binding": "SESSION",
      "id": "ff377a7aceb140989f372ff607ac04f4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "catalog-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
