---
import PublicLayout from '../layouts/PublicLayout.astro';

export const prerender = false;
---

<PublicLayout
  title="Sunucu hatası"
  description="Beklenmeyen bir hata oluştu."
  noindex
>
  <section class="mx-auto max-w-6xl px-4 py-24 text-center md:px-6" role="alert">
    <p class="font-display text-sm font-semibold uppercase tracking-widest text-muted-foreground">
      500
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold">Bir şeyler ters gitti</h1>
    <p class="mx-auto mt-3 max-w-md text-muted-foreground">
      İsteğiniz işlenirken beklenmeyen bir hata oluştu. Biraz sonra tekrar deneyin.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90"
      >
        Ana sayfa
      </a>
      <a
        href="/catalog"
        class="inline-flex rounded-md border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted"
      >
        Kataloğa git
      </a>
    </div>
  </section>
</PublicLayout>
