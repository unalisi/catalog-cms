---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="Katalog" description="Ürün listesi — yakında">
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <h1 class="font-display text-3xl font-bold">Katalog</h1>
    <p class="mt-3 max-w-xl text-muted-foreground">
      Ürün listesi FAZ 1 ile D1 + KV üzerinden gelecek. Şimdilik boş durum iskeleti.
    </p>
    <div class="mt-10 rounded-md border border-dashed border-border bg-muted/30 px-6 py-16 text-center">
      <p class="font-display text-lg font-semibold">Henüz ürün yok</p>
      <p class="mt-2 text-sm text-muted-foreground">Seed verisi FAZ 1’de eklenecek.</p>
    </div>
  </section>
</PublicLayout>
