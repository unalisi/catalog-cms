---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import DeleteButton from '../../../components/admin/DeleteButton';
import { listAdminPages } from '../../../server/services/pages';

const pages = await listAdminPages();
---

<AdminLayout
  title="Sayfalar"
  breadcrumbs={[{ href: '/admin', label: 'Admin' }, { label: 'Sayfalar' }]}
>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight">Sayfalar</h1>
        <p class="mt-1 text-sm text-muted-foreground">{pages.length} kayıt · section editör</p>
      </div>
      <a
        href="/admin/pages/new"
        class="inline-flex rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
      >
        Yeni sayfa
      </a>
    </div>

    {
      pages.length === 0 ? (
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <EmptyState
            title="Henüz sayfa yok"
            description="Ana sayfa seed’ini yükleyin veya yeni sayfa oluşturun."
            actionHref="/admin/pages/new"
            actionLabel="Sayfa ekle"
          />
        </div>
      ) : (
        <div class="overflow-hidden rounded-lg border border-border bg-background">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[36rem] text-left text-sm">
              <thead class="bg-muted">
                <tr>
                  <th class="px-3 py-2 font-medium">Başlık</th>
                  <th class="px-3 py-2 font-medium">Slug</th>
                  <th class="px-3 py-2 font-medium">Durum</th>
                  <th class="px-3 py-2 font-medium">Section</th>
                  <th class="px-3 py-2 font-medium">İşlem</th>
                </tr>
              </thead>
              <tbody>
                {pages.map((page) => (
                  <tr class="border-t border-border hover:bg-muted/40">
                    <td class="px-3 py-2 font-medium">{page.title}</td>
                    <td class="px-3 py-2 font-mono text-muted-foreground">{page.slug}</td>
                    <td class="px-3 py-2">{page.status}</td>
                    <td class="px-3 py-2 font-mono">{page.sectionCount}</td>
                    <td class="px-3 py-2">
                      <div class="flex items-center gap-3">
                        <a href={`/admin/pages/${page.slug}`} class="hover:underline">
                          Düzenle
                        </a>
                        {page.slug !== 'home' && (
                          <DeleteButton
                            client:load
                            endpoint={`/api/admin/pages/${page.slug}`}
                            redirectTo="/admin/pages"
                          />
                        )}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>
</AdminLayout>
