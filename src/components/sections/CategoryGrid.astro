---
import type { SectionConfigMap } from '../../lib/sections/registry';
import { getCategories } from '../../server/services/catalog';

interface Props {
  config: SectionConfigMap['category-grid'];
}

const { config } = Astro.props;
const { data: categories } = await getCategories();
const cols =
  config.columns === 4
    ? 'md:grid-cols-4'
    : config.columns === 3
      ? 'md:grid-cols-3'
      : 'md:grid-cols-2';
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  {config.title && <h2 class="font-display text-2xl font-bold">{config.title}</h2>}
  <div class={`mt-6 grid gap-4 ${cols}`}>
    {
      (categories ?? []).length === 0 ? (
        <p class="text-sm text-muted-foreground">Kategori yok.</p>
      ) : (
        (categories ?? []).map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="border border-border px-4 py-6 transition-colors hover:border-primary hover:bg-primary/5"
          >
            <span class="font-display text-lg font-semibold">{cat.name}</span>
            {cat.description && (
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{cat.description}</p>
            )}
          </a>
        ))
      )
    }
  </div>
</section>
