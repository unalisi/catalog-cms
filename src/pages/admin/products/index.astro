---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import DeleteButton from '../../../components/admin/DeleteButton';
import AdminListCard from '../../../components/admin/AdminListCard.astro';
import ProductBulkEditButton from '../../../components/admin/ProductBulkEditButton';
import { StatusDot } from '../../../components/admin/StatusDot';
import { getDb } from '../../../server/db';
import { listAllBrands } from '../../../server/repos/admin';
import {
  ADMIN_PRODUCT_PAGE_SIZES,
  listProductsAdminPage,
} from '../../../server/repos/products-admin';

const db = getDb();

const rawPage = Number(Astro.url.searchParams.get('page') ?? '1');
const rawPageSize = Number(Astro.url.searchParams.get('pageSize') ?? '20');

const [listResult, brandRows] = await Promise.all([
  listProductsAdminPage(db, { page: rawPage, pageSize: rawPageSize }),
  listAllBrands(db),
]);

const { items: products, total, page, pageSize } = listResult;

const pageSizeInvalid = rawPageSize !== 20 && rawPageSize !== 50;
if (pageSizeInvalid || rawPage !== page) {
  const q = new URLSearchParams({
    page: String(page),
    pageSize: String(pageSize),
  });
  return Astro.redirect(`/admin/products?${q.toString()}`);
}

const totalPages = Math.max(1, Math.ceil(total / pageSize) || 1);
const brands = brandRows.map((b) => ({ id: b.id, name: b.name }));

const rangeStart = total === 0 ? 0 : (page - 1) * pageSize + 1;
const rangeEnd = Math.min(page * pageSize, total);

function formatPrice(minor: number): string {
  return (minor / 100).toLocaleString('tr-TR', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function pageHref(nextPage: number, nextSize = pageSize): string {
  const q = new URLSearchParams();
  q.set('page', String(nextPage));
  q.set('pageSize', String(nextSize));
  return `/admin/products?${q.toString()}`;
}
---

<AdminLayout
  title="Ürünler"
  breadcrumbs={[{ href: '/admin', label: 'Panel' }, { label: 'Ürünler' }]}
>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <p class="text-sm text-muted-foreground">
        {
          total === 0
            ? '0 ürün'
            : `${rangeStart}–${rangeEnd} / ${total} ürün`
        }
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <ProductBulkEditButton client:visible brands={brands} />
        <a
          href="/admin/products/new"
          class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:flex-initial sm:min-h-9"
        >
          <span aria-hidden="true">+</span>
          Yeni Ürün
        </a>
      </div>
    </div>

    {
      total === 0 ? (
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <EmptyState
            title="Henüz ürün yok"
            description="İlk ürünü ekleyerek kataloğu doldurun."
            actionHref="/admin/products/new"
            actionLabel="Ürün ekle"
          />
        </div>
      ) : (
        <>
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-border bg-background px-3 py-2.5">
            <form
              method="get"
              action="/admin/products"
              class="flex items-center gap-2 text-sm text-muted-foreground"
            >
              <input type="hidden" name="page" value="1" />
              <label class="flex items-center gap-2">
                <span class="whitespace-nowrap">Sayfada</span>
                <select
                  id="product-page-size"
                  name="pageSize"
                  class="min-h-11 rounded-md border border-input bg-background px-2.5 py-1.5 text-sm text-foreground md:min-h-9"
                >
                  {ADMIN_PRODUCT_PAGE_SIZES.map((size) => (
                    <option value={size} selected={size === pageSize}>
                      {size}
                    </option>
                  ))}
                </select>
                <span>ürün</span>
              </label>
            </form>
            <div class="flex items-center gap-2">
              {page > 1 ? (
                <a
                  href={pageHref(page - 1)}
                  class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted md:min-h-9"
                >
                  Önceki
                </a>
              ) : (
                <span class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm text-muted-foreground opacity-50 md:min-h-9">
                  Önceki
                </span>
              )}
              <span class="min-w-[4.5rem] text-center text-sm text-muted-foreground">
                {page} / {totalPages}
              </span>
              {page < totalPages ? (
                <a
                  href={pageHref(page + 1)}
                  class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted md:min-h-9"
                >
                  Sonraki
                </a>
              ) : (
                <span class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm text-muted-foreground opacity-50 md:min-h-9">
                  Sonraki
                </span>
              )}
            </div>
          </div>

          <div class="flex flex-col gap-2 md:hidden">
            {products.map((product) => (
              <AdminListCard
                href={`/admin/products/${product.id}`}
                title={product.name}
                imageUrl={product.imageUrl}
                imageFallback={product.name}
                status={product.status}
                meta={[
                  product.sku || 'SKU yok',
                  product.brandName || 'Marka yok',
                  `${formatPrice(product.price)} ₺`,
                  `Stok ${product.stock}`,
                ]}
                deleteEndpoint={`/api/admin/products/${product.id}`}
              />
            ))}
          </div>

          <div class="hidden overflow-x-auto rounded-md border border-border bg-background md:block">
            <table class="w-full min-w-[52rem] border-collapse text-left text-sm">
              <thead class="bg-muted text-xs font-medium">
                <tr>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Görsel</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Ad</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">SKU</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Marka</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Fiyat</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Stok</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Durum</th>
                  <th class="border-b border-border px-3 py-2.5 font-medium">İşlem</th>
                </tr>
              </thead>
              <tbody>
                {products.map((product) => (
                  <tr class="bg-background hover:bg-muted/40">
                    <td class="border-b border-r border-border px-3 py-2">
                      {product.imageUrl ? (
                        <img
                          src={product.imageUrl}
                          alt=""
                          class="size-10 rounded-md border border-border bg-background object-contain p-0.5"
                          loading="lazy"
                          width="40"
                          height="40"
                        />
                      ) : (
                        <div
                          class="flex size-10 items-center justify-center rounded-md border border-border bg-primary-soft text-xs font-semibold text-primary"
                          aria-hidden="true"
                        >
                          {product.name.slice(0, 2).toUpperCase()}
                        </div>
                      )}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2 font-medium">{product.name}</td>
                    <td class="border-b border-r border-border px-3 py-2 font-mono text-muted-foreground">
                      {product.sku || '—'}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2 text-muted-foreground">
                      {product.brandName || '—'}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2 font-mono">
                      {formatPrice(product.price)}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2 font-mono">{product.stock}</td>
                    <td class="border-b border-r border-border px-3 py-2">
                      <StatusDot status={product.status} />
                    </td>
                    <td class="border-b border-border px-3 py-2">
                      <div class="flex items-center gap-3">
                        <a
                          href={`/admin/products/${product.id}`}
                          class="text-xs font-medium text-primary hover:underline"
                        >
                          Düzenle
                        </a>
                        <DeleteButton
                          client:visible
                          endpoint={`/api/admin/products/${product.id}`}
                        />
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-muted-foreground">
              {rangeStart}–{rangeEnd} / {total}
            </p>
            <div class="flex items-center gap-2">
              {page > 1 ? (
                <a
                  href={pageHref(page - 1)}
                  class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted md:min-h-9"
                >
                  Önceki
                </a>
              ) : null}
              {page < totalPages ? (
                <a
                  href={pageHref(page + 1)}
                  class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted md:min-h-9"
                >
                  Sonraki
                </a>
              ) : null}
            </div>
          </div>
        </>
      )
    }
  </div>

  <script>
    function bindProductPageSizeSelect() {
      const select = document.getElementById('product-page-size');
      if (!(select instanceof HTMLSelectElement) || select.dataset.bound === '1') return;
      select.dataset.bound = '1';
      select.addEventListener('change', () => {
        select.form?.requestSubmit();
      });
    }

    document.addEventListener('astro:page-load', bindProductPageSizeSelect);
  </script>
</AdminLayout>
