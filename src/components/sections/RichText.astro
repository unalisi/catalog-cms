---
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['rich-text'];
}

const { config } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
  <div
    class="prose-cms space-y-4 text-base leading-relaxed [&_a]:underline [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-semibold [&_p]:text-foreground [&_ul]:list-disc [&_ul]:pl-5"
    set:html={config.html}
  />
</section>
