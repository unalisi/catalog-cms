---
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['faq'];
}

const { config } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
  {config.title && <h2 class="font-display text-2xl font-bold">{config.title}</h2>}
  <div class="mt-6 divide-y divide-border border-y border-border">
    {
      config.items.map((item) => (
        <details class="group py-4">
          <summary class="cursor-pointer list-none font-medium marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {item.question}
              <span class="text-muted-foreground transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </span>
          </summary>
          <p class="mt-3 text-sm text-muted-foreground">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
