---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SettingsForm from '../../../components/admin/SettingsForm';
---

<AdminLayout
  title="Ayarlar"
  breadcrumbs={[{ href: '/admin', label: 'Admin' }, { label: 'Ayarlar' }]}
>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-display text-2xl font-bold tracking-tight">Site ayarları</h1>
    </div>
    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <SettingsForm client:load />
    </div>
  </div>
</AdminLayout>
