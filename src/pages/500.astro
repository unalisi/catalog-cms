---
import ErrorLayout from '../layouts/ErrorLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';

export const prerender = false;
---

<ErrorLayout
  title="Sunucu hatası"
  description="Beklenmeyen bir hata oluştu."
>
  <ErrorPage
    code="500"
    title="Bir şeyler ters gitti"
    message="İsteğiniz işlenirken beklenmeyen bir hata oluştu. Biraz sonra tekrar deneyin."
  />
</ErrorLayout>
