---
import type { ContentStatus } from './StatusDot';
import { StatusDot } from './StatusDot';
import DeleteButton from './DeleteButton';

interface Props {
  href: string;
  title: string;
  meta?: string[];
  status?: ContentStatus;
  imageUrl?: string | null;
  imageFallback?: string;
  deleteEndpoint?: string;
  editLabel?: string;
}

const {
  href,
  title,
  meta = [],
  status,
  imageUrl,
  imageFallback,
  deleteEndpoint,
  editLabel = 'Düzenle',
} = Astro.props;

const initials = (imageFallback ?? title).slice(0, 2).toUpperCase();
---

<article class="rounded-md border border-border bg-background p-3">
  <div class="flex items-start gap-3">
    {
      imageUrl !== undefined && (
        imageUrl ? (
          <img
            src={imageUrl}
            alt=""
            class="size-11 shrink-0 rounded-md border border-border bg-background object-contain p-0.5"
            loading="lazy"
            width="44"
            height="44"
          />
        ) : (
          <div
            class="flex size-11 shrink-0 items-center justify-center rounded-md border border-border bg-primary-soft text-xs font-semibold text-primary"
            aria-hidden="true"
          >
            {initials}
          </div>
        )
      )
    }
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="truncate text-sm font-semibold text-foreground">{title}</h3>
        {status && <StatusDot status={status} className="shrink-0" />}
      </div>
      {
        meta.length > 0 && (
          <p class="mt-1 truncate text-xs text-muted-foreground">
            {meta.filter(Boolean).join(' · ')}
          </p>
        )
      }
      <div class="mt-3 flex min-h-11 items-center gap-4">
        <a href={href} class="text-sm font-medium text-primary hover:underline">
          {editLabel}
        </a>
        {
          deleteEndpoint && (
            <DeleteButton client:visible endpoint={deleteEndpoint} />
          )
        }
      </div>
    </div>
  </div>
</article>
