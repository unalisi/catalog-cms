---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { formatMoney } from '../../lib/money';
import { buildPageSeo } from '../../lib/seo/meta';
import {
  breadcrumbJsonLd,
  productJsonLd,
  stringifyJsonLd,
} from '../../lib/seo/jsonld';
import { getProductBySlug } from '../../server/services/catalog';
import { getSeoDefaults } from '../../server/services/seo';

export const prerender = false;

const { slug } = Astro.params;
const result = slug ? await getProductBySlug(slug) : { data: null, status: 'MISS' as const };
const product = result.data;
const status = result.status;
const { data: defaults } = await getSeoDefaults();
const seoDefaults = defaults!;

if (!product) {
  Astro.response.status = 404;
}

const origin = Astro.url.origin;
const seo = product
  ? buildPageSeo({
      title: product.name,
      description: product.description,
      path: `/product/${product.slug}`,
      origin,
      seoTitle: product.seo?.title,
      seoDescription: product.seo?.description,
      canonical: product.seo?.canonical,
      noindex: product.seo?.noindex,
      robotsExtra: product.seo?.robotsExtra,
      ogImageUrl: product.seo?.ogImageUrl,
      ogType: 'product',
      defaults: seoDefaults,
    })
  : buildPageSeo({
      title: 'Ürün bulunamadı',
      description: 'Aradığınız ürün mevcut değil.',
      path: `/product/${slug ?? ''}`,
      origin,
      noindex: true,
      defaults: seoDefaults,
    });

const jsonLd = product
  ? stringifyJsonLd([
      productJsonLd({
        origin,
        name: product.name,
        description: product.description,
        slug: product.slug,
        sku: product.sku,
        price: product.price,
        currency: product.currency,
        brandName: product.brand?.name,
        imageUrl: product.seo?.ogImageUrl ?? undefined,
      }),
      breadcrumbJsonLd(origin, [
        { name: 'Katalog', path: '/catalog' },
        ...(product.brand
          ? [{ name: product.brand.name, path: `/brand/${product.brand.slug}` }]
          : []),
        { name: product.name, path: `/product/${product.slug}` },
      ]),
    ])
  : null;

if (product) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
  Astro.response.headers.set('X-Cache', status);
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
---

<PublicLayout seo={seo} cacheStatus={product ? status : null} jsonLd={jsonLd}>
  {
    !product ? (
      <section class="mx-auto max-w-6xl px-4 py-24 text-center md:px-6">
        <h1 class="font-display text-3xl font-bold">Ürün bulunamadı</h1>
        <p class="mt-3 text-muted-foreground">Bu slug ile yayınlanmış ürün yok.</p>
        <a
          href="/catalog"
          class="mt-8 inline-flex rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground"
        >
          Kataloğa dön
        </a>
      </section>
    ) : (
      <article class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
          <ol class="flex flex-wrap gap-2">
            <li>
              <a href="/catalog" class="hover:text-foreground">
                Katalog
              </a>
            </li>
            <li aria-hidden="true">/</li>
            {product.brand && (
              <>
                <li>
                  <a href={`/brand/${product.brand.slug}`} class="hover:text-foreground">
                    {product.brand.name}
                  </a>
                </li>
                <li aria-hidden="true">/</li>
              </>
            )}
            <li class="text-foreground">{product.name}</li>
          </ol>
        </nav>

        <div class="flex flex-col gap-6 border-b border-border pb-8">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-2xl">
              <p class="font-mono text-sm text-muted-foreground">SKU {product.sku ?? '—'}</p>
              <h1 class="mt-2 font-display text-3xl font-bold md:text-4xl">{product.name}</h1>
            </div>
            <div class="text-right">
              <p class="font-mono text-2xl font-bold text-primary">
                {formatMoney(product.price, product.currency)}
              </p>
              {product.compareAtPrice != null && product.compareAtPrice > product.price && (
                <p class="font-mono text-sm text-muted-foreground line-through">
                  {formatMoney(product.compareAtPrice, product.currency)}
                </p>
              )}
              <p class="mt-1 text-sm text-muted-foreground">Stok: {product.stock}</p>
            </div>
          </div>
          {product.description && (
            <p class="max-w-2xl text-lg text-muted-foreground">{product.description}</p>
          )}
        </div>

        {product.categories.length > 0 && (
          <div class="mt-8">
            <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-muted-foreground">
              Kategoriler
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {product.categories.map((cat) => (
                <li>
                  <a
                    href={`/category/${cat.slug}`}
                    class="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-muted"
                  >
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {product.variants.length > 0 && (
          <div class="mt-10">
            <h2 class="font-display text-xl font-semibold">Varyantlar</h2>
            <ul class="mt-4 divide-y divide-border border-t border-border">
              {product.variants.map((variant) => (
                <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                  <div>
                    <p class="font-medium">{variant.name}</p>
                    <p class="font-mono text-sm text-muted-foreground">{variant.sku}</p>
                  </div>
                  <div class="text-right">
                    <p class="font-mono font-semibold text-primary">
                      {formatMoney(variant.price, product.currency)}
                    </p>
                    <p class="text-sm text-muted-foreground">Stok {variant.stock}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}

        <p class="mt-10 text-xs text-muted-foreground">Cache: {status}</p>
      </article>
    )
  }
</PublicLayout>
