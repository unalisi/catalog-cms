---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductGrid from '../../../components/admin/product-grid/ProductGrid';
import { getDb } from '../../../server/db';
import { listAllBrands } from '../../../server/repos/admin';
import { listProductsForGrid } from '../../../server/repos/products-admin';

const db = getDb();
const products = await listProductsForGrid(db);
const brands = (await listAllBrands(db)).map((b) => ({ id: b.id, name: b.name }));
---

<AdminLayout
  title="Ürünler"
  breadcrumbs={[{ href: '/admin', label: 'Panel' }, { label: 'Ürünler' }]}
>
  <div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground">{products.length} kayıt · Excel-benzeri grid</p>
      <a
        href="/admin/products/new"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-foreground hover:opacity-90"
      >
        <span aria-hidden="true">+</span>
        Yeni Ürün
      </a>
    </div>

    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <ProductGrid client:load initialProducts={products} brands={brands} />
    </div>
  </div>
</AdminLayout>
