---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { buildPageSeo } from '../../lib/seo/meta';
import {
  breadcrumbJsonLd,
  productJsonLd,
  stringifyJsonLd,
} from '../../lib/seo/jsonld';
import { getProductBySlug } from '../../server/services/catalog';
import { getPublishedPage } from '../../server/services/pages';
import { ensureCorePages } from '../../server/services/core-pages';
import { getSeoDefaults } from '../../server/services/seo';
import SectionRenderer from '../../components/sections/SectionRenderer.astro';

export const prerender = false;

const { slug } = Astro.params;
await ensureCorePages();
const result = slug ? await getProductBySlug(slug) : { data: null, status: 'MISS' as const };
const product = result.data;
const status = result.status;
const [{ data: defaults }, { data: templatePage }] = await Promise.all([
  getSeoDefaults(),
  getPublishedPage('urun-sablon'),
]);
const seoDefaults = defaults!;

if (!product) {
  Astro.response.status = 404;
}

const origin = Astro.url.origin;
const primaryImage =
  product?.images?.[0]?.url ?? product?.imageUrl ?? product?.seo?.ogImageUrl ?? undefined;

const seo = product
  ? buildPageSeo({
      title: product.name,
      description: product.description,
      path: `/product/${product.slug}`,
      origin,
      seoTitle: product.seo?.title,
      seoDescription: product.seo?.description,
      canonical: product.seo?.canonical,
      noindex: product.seo?.noindex,
      robotsExtra: product.seo?.robotsExtra,
      ogImageUrl: product.seo?.ogImageUrl ?? primaryImage ?? null,
      ogType: 'product',
      defaults: seoDefaults,
    })
  : buildPageSeo({
      title: 'Ürün bulunamadı',
      description: 'Aradığınız ürün mevcut değil.',
      path: `/product/${slug ?? ''}`,
      origin,
      noindex: true,
      defaults: seoDefaults,
    });

const jsonLd = product
  ? stringifyJsonLd([
      productJsonLd({
        origin,
        name: product.name,
        description: product.description,
        slug: product.slug,
        sku: product.sku,
        price: product.price,
        currency: product.currency,
        brandName: product.brand?.name,
        imageUrl: primaryImage,
      }),
      breadcrumbJsonLd(origin, [
        { name: 'Katalog', path: '/catalog' },
        ...(product.brand
          ? [{ name: product.brand.name, path: `/brand/${product.brand.slug}` }]
          : []),
        { name: product.name, path: `/product/${product.slug}` },
      ]),
    ])
  : null;

if (product) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
  Astro.response.headers.set('X-Cache', status);
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const sections = templatePage?.sections ?? [];
---

<PublicLayout seo={seo} cacheStatus={product ? status : null} jsonLd={jsonLd}>
  {
    !product ? (
      <section class="mx-auto max-w-6xl px-4 py-24 text-center md:px-6">
        <h1 class="font-display text-3xl font-bold">Ürün bulunamadı</h1>
        <p class="mt-3 text-muted-foreground">Bu slug ile yayınlanmış ürün yok.</p>
        <a
          href="/catalog"
          class="mt-8 inline-flex rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground"
        >
          Kataloğa dön
        </a>
      </section>
    ) : sections.length > 0 ? (
      <SectionRenderer sections={sections} product={product} />
    ) : (
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
        <h1 class="font-display text-3xl font-bold">{product.name}</h1>
        <p class="mt-3 text-muted-foreground">
          Ürün şablonu (urun-sablon) henüz yapılandırılmamış.
        </p>
      </section>
    )
  }
</PublicLayout>
