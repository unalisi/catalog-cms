---
import type { SectionConfigMap } from '../../lib/sections/registry';

interface Props {
  config: SectionConfigMap['why-us'];
}

const { config } = Astro.props;
const items = config.items ?? [];
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
  <div class="max-w-2xl">
    <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{config.title}</h2>
    {
      config.subtitle && (
        <p class="mt-3 text-muted-foreground">{config.subtitle}</p>
      )
    }
  </div>
  <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <li class="border-t border-border pt-6">
          <div class="mb-4 flex size-10 items-center justify-center border border-border bg-muted font-display text-sm font-bold text-foreground">
            {(item.icon || item.title).slice(0, 1).toUpperCase()}
          </div>
          <h3 class="font-display text-lg font-semibold tracking-tight">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>
