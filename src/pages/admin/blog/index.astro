---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import DeleteButton from '../../../components/admin/DeleteButton';
import AdminListCard from '../../../components/admin/AdminListCard.astro';
import { listAdminPosts } from '../../../server/services/posts';

const posts = await listAdminPosts();
const now = Date.now();

function statusLabel(status: string, publishedAt: string | null) {
  if (status === 'published' && publishedAt && Date.parse(publishedAt) > now) {
    return 'planlı';
  }
  return status;
}
---

<AdminLayout
  title="Blog"
  breadcrumbs={[{ href: '/admin', label: 'Admin' }, { label: 'Blog' }]}
>
  <div class="flex flex-col gap-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-start sm:justify-between">
      <div>
        <h1 class="font-display text-2xl font-bold tracking-tight">Blog</h1>
        <p class="mt-1 text-sm text-muted-foreground">{posts.length} yazı</p>
      </div>
      <a
        href="/admin/blog/new"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:min-h-9"
      >
        <span aria-hidden="true">+</span>
        Yeni yazı
      </a>
    </div>

    {
      posts.length === 0 ? (
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <EmptyState
            title="Henüz yazı yok"
            description="İlk blog yazısını oluşturun. İçerik sanitize edilmiş HTML olarak saklanır."
            actionHref="/admin/blog/new"
            actionLabel="Yazı ekle"
          />
        </div>
      ) : (
        <>
          <div class="flex flex-col gap-2 md:hidden">
            {posts.map((post) => (
              <AdminListCard
                href={`/admin/blog/${post.id}`}
                title={post.title}
                status={post.status}
                meta={[
                  post.slug,
                  statusLabel(post.status, post.publishedAt),
                  post.publishedAt
                    ? new Date(post.publishedAt).toLocaleDateString('tr-TR')
                    : 'Yayın yok',
                  post.tags.join(', ') || undefined,
                ].filter(Boolean) as string[]}
                deleteEndpoint={`/api/admin/posts/${post.id}`}
              />
            ))}
          </div>
          <div class="hidden overflow-x-auto rounded-md border border-border bg-background md:block">
            <table class="w-full min-w-[48rem] border-collapse text-left text-sm">
              <thead class="bg-muted text-xs font-medium">
                <tr>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Başlık</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Slug</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Durum</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Yayın</th>
                  <th class="border-b border-r border-border px-3 py-2.5 font-medium">Etiket</th>
                  <th class="border-b border-border px-3 py-2.5 font-medium">İşlem</th>
                </tr>
              </thead>
              <tbody>
                {posts.map((post) => (
                  <tr class="bg-background hover:bg-muted/40">
                    <td class="border-b border-r border-border px-3 py-2 font-medium">{post.title}</td>
                    <td class="border-b border-r border-border px-3 py-2 font-mono text-muted-foreground">
                      {post.slug}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2">
                      {statusLabel(post.status, post.publishedAt)}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2 text-muted-foreground">
                      {post.publishedAt ? new Date(post.publishedAt).toLocaleString('tr-TR') : '—'}
                    </td>
                    <td class="border-b border-r border-border px-3 py-2 text-muted-foreground">
                      {post.tags.join(', ') || '—'}
                    </td>
                    <td class="border-b border-border px-3 py-2">
                      <div class="flex items-center gap-3">
                        <a href={`/admin/blog/${post.id}`} class="hover:underline">
                          Düzenle
                        </a>
                        <DeleteButton client:load endpoint={`/api/admin/posts/${post.id}`} />
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }
  </div>
</AdminLayout>
