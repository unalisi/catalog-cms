---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div class="flex flex-col gap-6">
    <div>
      <p class="text-sm text-muted-foreground">Admin</p>
      <h1 class="font-display text-2xl font-bold">Dashboard</h1>
    </div>
    <p class="max-w-2xl text-muted-foreground">
      FAZ 0 iskeleti hazır. Kimlik doğrulama, CRUD ve veri katmanı sonraki fazlarda eklenecek.
    </p>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-md border border-border bg-muted/30 p-4">
        <p class="text-sm text-muted-foreground">Ürünler</p>
        <p class="font-display text-2xl font-bold">—</p>
      </div>
      <div class="rounded-md border border-border bg-muted/30 p-4">
        <p class="text-sm text-muted-foreground">Markalar</p>
        <p class="font-display text-2xl font-bold">—</p>
      </div>
      <div class="rounded-md border border-border bg-muted/30 p-4">
        <p class="text-sm text-muted-foreground">Kategoriler</p>
        <p class="font-display text-2xl font-bold">—</p>
      </div>
    </div>
  </div>
</AdminLayout>
