---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BrandForm from '../../../components/admin/BrandForm';
---

<AdminLayout
  title="Yeni marka"
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/brands', label: 'Markalar' },
    { label: 'Yeni' },
  ]}
>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-display text-2xl font-bold tracking-tight">Yeni marka</h1>
    </div>
    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <BrandForm client:load mode="create" />
    </div>
  </div>
</AdminLayout>
