---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { DashboardOverview } from '../../components/admin/DashboardOverview';
import { getDb } from '../../server/db';
import { getDashboardOverview } from '../../server/repos/admin';

const overview = await getDashboardOverview(getDb());
---

<AdminLayout title="Genel Bakış" breadcrumbs={[{ label: 'Genel Bakış' }]}>
  <DashboardOverview
    products={overview.products}
    published={overview.published}
    draft={overview.draft}
    archived={overview.archived}
    coverage={overview.coverage}
    recentProducts={overview.recentProducts}
    homeSections={overview.homeSections}
    homePageSlug="home"
  />
</AdminLayout>
