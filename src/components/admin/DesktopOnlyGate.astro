---
type Props = {
  message?: string;
};

const message =
  Astro.props.message ?? 'Yalnızca masaüstü cihazlarda düzenlenebilir';
---

<div
  class="flex min-h-[50dvh] flex-col items-center justify-center gap-3 rounded-lg border border-dashed border-border bg-muted/30 px-6 py-16 text-center md:hidden"
  role="status"
>
  <p class="font-display text-lg font-semibold tracking-tight text-foreground">
    {message}
  </p>
  <p class="max-w-sm text-sm text-muted-foreground">
    Bu ekranı 768px veya daha geniş bir cihazda açın.
  </p>
</div>

<div class="hidden md:contents">
  <slot />
</div>
