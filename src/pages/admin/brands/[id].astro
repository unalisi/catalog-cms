---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BrandForm from '../../../components/admin/BrandForm';
import { getDb } from '../../../server/db';
import { getBrandById } from '../../../server/repos/admin';
import { getSeoById } from '../../../server/repos/seo';

const { id } = Astro.params;
const brand = id ? await getBrandById(getDb(), id) : null;
const seo = brand?.seoId ? await getSeoById(getDb(), brand.seoId) : null;
if (!brand) {
  Astro.response.status = 404;
}
---

<AdminLayout
  title={brand ? `Düzenle · ${brand.name}` : 'Marka bulunamadı'}
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/brands', label: 'Markalar' },
    { label: brand?.name ?? 'Bulunamadı' },
  ]}
>
  {
    !brand ? (
      <p>Marka bulunamadı.</p>
    ) : (
      <div class="flex flex-col gap-4">
        <div>
          <h1 class="font-display text-2xl font-bold tracking-tight">{brand.name}</h1>
        </div>
        <div class="rounded-lg border border-border bg-background p-4 md:p-6">
          <BrandForm
            client:load
            mode="edit"
            brandId={brand.id}
            initial={{
              name: brand.name,
              slug: brand.slug,
              description: brand.description ?? '',
              status: brand.status,
              seo,
            }}
          />
        </div>
      </div>
    )
  }
</AdminLayout>
