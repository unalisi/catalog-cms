---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import { AdminShell } from '../components/admin/AdminShell';
import AdminNavProgress from '../components/admin/AdminNavProgress.astro';
import { Toaster } from '../components/ui/sonner';

interface Props {
  title?: string;
  breadcrumbs?: { href?: string; label: string }[];
  breadcrumbExtra?: string;
}

const { title = 'Admin', breadcrumbs = [], breadcrumbExtra } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user ?? null;

const sidebarCookie = Astro.cookies.get('sidebar_state');
const defaultSidebarOpen = sidebarCookie ? sidebarCookie.value === 'true' : true;

const pageFade = fade({ duration: '220ms' });

// Only serializable fields — Lucide icon components must NOT cross the Astro→island boundary.
const shellUser = user
  ? {
      id: user.id,
      email: user.email,
      name: user.email,
      roleId: user.roleId,
      roleSlug: user.roleSlug,
      roleName: user.roleName,
      permissions: user.permissions,
      mustChangePassword: user.mustChangePassword,
    }
  : null;
---

<!doctype html>
<html lang="tr" class="antialiased" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Admin</title>
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground">
    <AdminNavProgress />
    <a
      href="#admin-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    >
      İçeriğe geç
    </a>
    <div id="admin-page" class="min-h-dvh" transition:animate={pageFade}>
      <AdminShell
        client:load
        currentPath={pathname}
        breadcrumbs={breadcrumbs.length > 0 ? breadcrumbs : undefined}
        breadcrumbExtra={breadcrumbExtra}
        defaultSidebarOpen={defaultSidebarOpen}
        user={shellUser}
      >
        <slot />
      </AdminShell>
    </div>
    <Toaster client:load />
  </body>
</html>
