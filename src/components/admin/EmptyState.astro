---
interface Props {
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div class="rounded-md border border-dashed border-border bg-muted/30 px-6 py-16 text-center">
  <p class="font-display text-lg font-semibold">{title}</p>
  <p class="mt-2 text-sm text-muted-foreground">{description}</p>
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="mt-6 inline-flex h-9 items-center gap-2 rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-muted"
      >
        <span aria-hidden="true">+</span>
        {actionLabel}
      </a>
    )
  }
</div>
