---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostForm from '../../../components/admin/PostForm';
---

<AdminLayout
  title="Yeni yazı"
  breadcrumbs={[
    { href: '/admin', label: 'Admin' },
    { href: '/admin/blog', label: 'Blog' },
    { label: 'Yeni' },
  ]}
>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="font-display text-2xl font-bold tracking-tight">Yeni yazı</h1>
    </div>
    <div class="rounded-lg border border-border bg-background p-4 md:p-6">
      <PostForm client:load mode="create" />
    </div>
  </div>
</AdminLayout>
